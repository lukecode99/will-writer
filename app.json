{
  "expo": {
    "name": "Will Writer",
    "slug": "will-writer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B3A6B"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.lukeholder.willwriter",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "web": {
      "backgroundColor": "#1B3A6B",
      "themeColor": "#1B3A6B",
      "favicon": "./assets/favicon.png"
    },
    "platforms": ["ios", "web"],
    "experiments": {
      "baseUrl": "/will-writer"
    }
  }
}
